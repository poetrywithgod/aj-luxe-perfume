From 465fdd679405e14ea98a8462b7927001a7f67a7b Mon Sep 17 00:00:00 2001
From: Ctrl Kommanda <victor@ctrlbuild.tech>
Date: Fri, 11 Sep 2026 07:23:07 +0000
Subject: [PATCH] Fix real TS type error in shop search/filter query (from
 actual Vercel build)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A genuine bug, not sandbox noise — this one only a real generated
Prisma client could catch, which is exactly what this build finally
had for the first time. `[priceWhere, searchWhere].filter(Boolean)`
doesn't narrow `undefined` out of the array's TYPE (only its runtime
values) — a well-known TypeScript gap, not a Prisma-specific issue.
The resulting `(ProductWhereInput | undefined)[]` being assigned to
Prisma's `AND` field is what broke — and per the actual build log,
that type error cascaded into corrupting the whole query's inferred
return type, which is why product.reviews/product.brand also came
back as 'doesn't exist' a few dozen lines later despite the query
correctly `include`-ing both.

Fixed with an explicit type-predicate filter
(`condition is NonNullable<typeof condition>`), the standard fix for
this exact TS gap.

Audited both apps for the same filter(Boolean) pattern used on a
Prisma where-clause array — this was the only other real instance;
the one other filter(Boolean) call in the codebase (product highlights
derived from description text) filters plain strings, not optional
where-clause objects, and isn't affected.

Worth being direct about: this sandbox has never had a working
generated Prisma client (no network access to binaries.prisma.sh), so
every round's tsc output here has been full of cascade noise that
genuinely was just noise — until this one, which was hiding inside it.
Real Vercel build logs are now the only full type-check this project
gets; please keep sharing them when a build fails rather than assuming
I've already caught everything from the sandbox alone.
---
 .../src/app/(shop)/shop/[[...category]]/page.tsx     | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/apps/storefront/src/app/(shop)/shop/[[...category]]/page.tsx b/apps/storefront/src/app/(shop)/shop/[[...category]]/page.tsx
index 3eb35c6..ad6414c 100644
--- a/apps/storefront/src/app/(shop)/shop/[[...category]]/page.tsx
+++ b/apps/storefront/src/app/(shop)/shop/[[...category]]/page.tsx
@@ -130,14 +130,20 @@ export default async function ShopPage({ params, searchParams }: PageProps) {
   // priceWhere and searchWhere both need their own top-level `OR` — an
   // object spread would let the second silently clobber the first, so
   // any conditions with their own OR go into an `AND` array instead.
+  // `.filter(Boolean)` alone doesn't narrow away `undefined` in the
+  // array's type (a known TS gap), which was silently corrupting this
+  // whole query's inferred return type — hence the explicit type guard.
+  const andConditions = [priceWhere, searchWhere].filter(
+    (condition): condition is NonNullable<typeof condition> =>
+      Boolean(condition),
+  );
+
   const where = {
     ...categoryWhere,
     ...(activeGenders.length > 0 && { gender: { in: activeGenders } }),
     ...(activeScents.length > 0 && { scentProfile: { in: activeScents } }),
     ...(activeBrands.length > 0 && { brand: { slug: { in: activeBrands } } }),
-    ...((priceWhere || searchWhere) && {
-      AND: [priceWhere, searchWhere].filter(Boolean),
-    }),
+    ...(andConditions.length > 0 && { AND: andConditions }),
   };
 
   const basePath = category ? `/shop/${category.slug}` : "/shop";
-- 
