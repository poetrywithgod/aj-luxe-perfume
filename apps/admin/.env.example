# Copy this to .env.local and fill in real values. Next.js only auto-loads
# .env files from an app's own directory, so this lives in apps/admin (not
# the repo root) — see packages/db/.env for the same DB values needed
# there for Prisma migrations.

# Same Supabase Postgres database as the storefront — one DB, two apps.
DATABASE_URL=

# Direct (non-pooled) connection, used by Prisma migrations
DIRECT_URL=

# Separate from the storefront's SESSION_SECRET — different app, different
# cookie, different audience (AdminUser sessions, not Customer ones).
# Generate a long random string, e.g.: openssl rand -base64 48
ADMIN_SESSION_SECRET=
