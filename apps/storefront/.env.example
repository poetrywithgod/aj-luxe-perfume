# Copy this to .env.local and fill in real values. Next.js only auto-loads
# .env files from an app's own directory, so this lives in apps/storefront
# (not the repo root) — see packages/db/.env for the same values needed
# there for Prisma migrations.

# Supabase Postgres connection (already required — pooled connection used
# at runtime by the pg driver adapter in packages/db/src/client.ts)
DATABASE_URL=

# Direct (non-pooled) connection, used by Prisma migrations
DIRECT_URL=

# NEW — required for authentication (login/signup sessions). Generate a
# long random string, e.g.: openssl rand -base64 48
SESSION_SECRET=

# NEW — canonical production URL, used for sitemap.xml, robots.txt, and
# resolving absolute URLs in metadata/structured data. Falls back to
# https://ajluxeperfume.com if unset (see src/lib/site.ts) — only needs
# setting explicitly if the real domain differs from that.
NEXT_PUBLIC_SITE_URL=
