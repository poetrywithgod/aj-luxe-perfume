generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  PAY_ON_DELIVERY
}

enum CustomerStatus {
  ACTIVE
  VIP
  INACTIVE
  BLOCKED
}

enum ReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  status        CustomerStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Email re-verification: when a customer changes their email in
  // settings, the real `email` column is left untouched and these three
  // fields hold the pending change until the confirmation link is
  // clicked. See src/lib/email.ts and /account/verify-email.
  pendingEmail       String?
  emailVerifyToken   String?   @unique
  emailVerifyExpires DateTime?

  // Forgot-password: a reset link's token/expiry. Cleared once used or
  // once a fresh one is requested. See /forgot-password + /reset-password.
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  // Basic login lockout: incremented on each failed password check by
  // POST /api/auth/login, reset to 0 on success. lockedUntil is set once
  // the threshold is hit and checked before the password is even
  // compared. Per-account rather than per-IP — no rate-limiting infra
  // (Redis/Upstash) is set up for this project yet, and this needs none.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  orders        Order[]
  reviews       Review[]
  conversations Conversation[]

  @@map("customers")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  messages     Message[]

  @@map("admin_users")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("brands")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String
  price         Decimal  @db.Decimal(10, 2)
  volumeMl      Int
  stock         Int      @default(0)
  scentProfile  String?
  gender        String?
  images        String[]
  isBestSeller  Boolean  @default(false)
  isNewProduct  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])

  orderItems    OrderItem[]
  reviews       Review[]

  @@map("products")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal       @db.Decimal(10, 2) @default(0)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)

  firstName       String
  lastName        String
  email           String
  phone           String
  address         String
  state           String
  city            String
  customerNote    String?

  paystackRef     String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])

  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  quantity   Int
  priceEach  Decimal  @db.Decimal(10, 2)

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id         String       @id @default(uuid())
  rating     Int
  comment    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])

  @@map("reviews")
}

model Conversation {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])

  messages   Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  body           String
  createdAt      DateTime     @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderAdminId  String?
  senderAdmin    AdminUser?   @relation(fields: [senderAdminId], references: [id])

  @@map("messages")
}
