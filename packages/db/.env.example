# Copy this to packages/db/.env and fill in real values. Used by Prisma
# CLI commands (migrate, generate, the seed script below) run from this
# package — apps/storefront and apps/admin each load the same values from
# their own .env.local instead (Next.js doesn't read this file).

DATABASE_URL=
DIRECT_URL=

# Used only by prisma/seed.ts (`pnpm --filter db db:seed`) to create the
# first AdminUser so there's someone who can log into apps/admin.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=
ADMIN_SEED_PASSWORD=
